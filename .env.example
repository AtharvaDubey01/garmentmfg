# GarmentMFG Application Environment Configuration
# Copy this file to .env and adjust variables as needed for your environment.

# Server Port (Express backend)
PORT=6061

# PostgreSQL Connection String
# Mac Homebrew default: postgresql://localhost:5432/garmentmfg
DATABASE_URL=postgresql://localhost:5432/garmentmfg

# Session & JWT secret key (keep private, do not commit)
SESSION_SECRET=garmentmfg_dev_secret_key_change_in_production

# Node Environment ('development' or 'production')
NODE_ENV=development
